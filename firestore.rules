rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace PASTE_YOUR_OWNER_UID with your UID (Firebase console → Authentication → Users).
    function isOwner() {
      return request.auth != null && request.auth.uid == "PASTE_YOUR_OWNER_UID";
    }
    // Site text: everyone can read, only you can change it.
    match /site/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }
    // Uploaded images (photo, certificates): everyone can read, only you can change them.
    match /images/{imageId} {
      allow read: if true;
      allow write: if isOwner() && request.resource.data.src is string && request.resource.data.src.size() < 1000000;
      allow delete: if isOwner();
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
